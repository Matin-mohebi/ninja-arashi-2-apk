{
  "applicationId": "ir.matin.ninja",
  "version": "1.4.0",
  "defaultMode": "window",
  "port": 0,
  "documentRoot": "/dist/",
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": true,
  "tokenSecurity": "one-time",
  "exportAuthInfo": false,
  "logging": {
    "enabled": true,
    "writeToLogFile": false
  },
  "nativeAllowList": [
    "app.*",
    "window.*",
    "debug.*"
  ],
  "modes": {
    "window": {
      "title": "NINJA ZEUS",
      "width": 1280,
      "height": 720,
      "minWidth": 480,
      "minHeight": 320,
      "fullScreen": false,
      "alwaysOnTop": false,
      "icon": "/dist/icon.png",
      "resizable": true,
      "maximize": false,
      "exitProcessOnClose": true
    }
  },
  "cli": {
    "binaryName": "NINJA-ZEUS",
    "resourcesPath": "/dist/",
    "extensionsPath": "/extensions/",
    "clientLibrary": "/dist/neutralino.js",
    "binaryVersion": "6.10.0",
    "clientVersion": "6.10.0",
    "distributionPath": "desktop-dist"
  }
}
